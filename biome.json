{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "examples/**",
      "test-dist/**",
      "*.ts",
      "*.json",
      "typedoc/*.json",
      "!package-lock.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 80 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "useBlockStatements": "error",
        "useObjectSpread": "error",
        "useReduceTypeParameter": "error",
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": false }
        },
        "useForOf": "error",
        "useFilenamingConvention": "error",
        "useErrorCause": "error",
        "useDefaultSwitchClause": "error",
        "useConst": "error",
        "useConsistentMethodSignatures": "error",
        "noContinue": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "warn",
          "options": { "ignoreRestSiblings": true }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.spec.ts"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts", "examples/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "snake_case"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
