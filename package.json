{
  "name": "ts-rules-composer",
  "version": "0.0.1",
  "description": "Typescript rules engine by composition",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Breno Magalhaes",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "generate-docs": "typedoc --options typedoc/typedoc.json",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.5",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.3.0",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "validation",
    "rules engine",
    "typescript",
    "pipeline",
    "combinator",
    "functional",
    "context-aware",
    "business logic",
    "async"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brenopms/ts-rules-composer.git"
  }
}
